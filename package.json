  "build": {
    "appId": "com.sweaxstudios.sweaxcut",
    "productName": "SWEAXCUT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SWEAXCUT-Kurulum-${version}.exe",
      "shortcutName": "SWEAXCUT"
    },
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*",
          "!whisper/models/**"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "sweax",
        "name": "SWEAXCUT Projesi",
        "role": "Editor"
      }
    ],
    "compression": "maximum"
  }
}
