# Bağımlılıklar ve derleme çıktıları
node_modules/
dist/
release/
out/

# Günlükler
*.log

# Yerel araç ayarları ve iç notlar (diskte kalır, yayımlanmaz)
.claude/
.private/
docs/AGENT-BRIEF.md
docs/research/

# Test videoları: test-videos/make-tests.cjs yeniden üretir; küçük sabit girdiler hariç
test-videos/*
!test-videos/*.cjs
!test-videos/bozuk.mp4
!test-videos/muzik.mp3
!test-videos/overlay_test.png

# Üçüncü parti ikililer ve modeller (npm run prepare:vendor indirir ya da elle konur, bkz. README)
vendor/whisper/bin/
vendor/whisper/bin-gpu/
vendor/whisper/models/
vendor/piper/*
!vendor/piper/NOTICE.txt
# MediaPipe wasm çalışma zamanı (13 MB): npm install sırasında scripts/copy-mediapipe.cjs kopyalar
public/models/mediapipe/wasm/

# Büyük medya ve ikililer hiçbir yerde izlenmez (docs/media seçilmiş, küçük tutulan istisnadır)
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.exe
*.dll
*.onnx
*.zip
*.7z
*.blockmap
*.bin
!vendor/whisper/vad/*.bin
!docs/media/*.mp4
!test-videos/bozuk.mp4

# Gizli ayarlar
.env
.env.*
*.pem
*.key

